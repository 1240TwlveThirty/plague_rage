{
	"scale": 2,
	"out_dir": "res://art/ui/x2",
	"theme_path": "res://art/ui/theme.tres",
	"font_variant": "fusion10",
	"fonts": {
		"min_scale": 2,
		"rounding": "nearest",
		"variants": {
			"default": {},
			"fusion12": {"file": "res://fonts/fusion_pixel/fusion-pixel-12px-proportional-zh_hans.ttf", "native": 12, "outline_max": 2},
			"fusion10": {"file": "res://fonts/fusion_pixel/fusion-pixel-10px-proportional-zh_hans.ttf", "native": 10, "outline_max": 2}
		}
	},
	"button": {
		"file": "res://art/ui/ui_button_c6.png",
		"corner": 6,
		"slice": 7,
		"states": 1,
		"state_rows": {"normal": 0, "hover": 0, "pressed": 0, "disabled": 0},
		"state_modulate": {"normal": "#ffffff", "hover": "#ffffff", "pressed": "#c0cbdc", "disabled": "#8b9bb4"},
		"pressed_shift": 2,
		"min_size": [320, 64],
		"text_pad": 8,
		"text_pad_v": 6,
		"font_colors": {"normal": "#c0cbdc", "hover": "#feae34", "pressed": "#feae34", "disabled": "#5a6988"},
		"outline_color": "#181425",
		"outline_size": 6
	},
	"panel": {
		"file": "res://art/ui/ui_panel_c8.png",
		"corner": 8,
		"slice": 9,
		"content_pad": 8,
		"label_outline_color": "#181425",
		"label_outline_size": 6
	},
	"slot": {
		"file": "res://art/ui/ui_slot_c6.png",
		"corner": 6,
		"slice": 8,
		"content_pad": 2,
		"content_pad_v": 0
	},
	"bar": {
		"frame": "res://art/ui/ui_bar_frame.png",
		"fill": "res://art/ui/ui_bar_fill.png",
		"fill_left": 2,
		"fill_right": 2
	}
}
